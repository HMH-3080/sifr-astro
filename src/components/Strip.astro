---
const { label, items } = Astro.props as { label: string; items: string[] };
---

<div class="strip">
  <div class="wrap strip-inner">
    <span class="strip-label" data-i18n="strip_label">{label}</span>
    <ul class="strip-items">
      {items.map((item, i) => <li data-i18n={`strip${i + 1}`}>{item}</li>)}
    </ul>
  </div>
</div>