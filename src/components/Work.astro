---
const work = [
  {
    key: 1,
    type: 'Software engineering',
    title: 'A unified operations platform',
    desc: 'Bringing orders, inventory and reporting into one coherent workflow.',
    delay: '',
    art: `<svg viewBox="0 0 360 220" fill="none" aria-hidden="true">
      <defs><linearGradient id="g3a" x1="40" y1="22" x2="300" y2="190">
        <stop stop-color="#7c8b9b" stop-opacity=".42"/><stop offset="1" stop-color="#252d37" stop-opacity=".2"/>
      </linearGradient></defs>
      <rect x="52" y="27" width="256" height="154" rx="9" fill="url(#g3a)" stroke="#9aa6b3" stroke-opacity=".55"/>
      <path d="M52 53h256" stroke="#9aa6b3" stroke-opacity=".4"/>
      <circle cx="68" cy="40" r="3" fill="#dbe4ee"/><circle cx="80" cy="40" r="3" fill="#8b96a2"/><circle cx="92" cy="40" r="3" fill="#8b96a2"/>
      <rect x="72" y="69" width="58" height="94" rx="4" fill="#0d1116" stroke="#8b96a2" stroke-opacity=".5"/>
      <rect x="143" y="69" width="144" height="39" rx="4" fill="#242c35" stroke="#8b96a2" stroke-opacity=".35"/>
      <rect x="143" y="119" width="67" height="44" rx="4" fill="#1e252d"/>
      <rect x="220" y="119" width="67" height="44" rx="4" fill="#1e252d"/>
      <path d="M84 84h34M84 94h27M84 108h34M84 118h22M154 83h80M154 93h52" stroke="#b7c2ce" stroke-opacity=".7" stroke-linecap="round"/>
      <path d="M153 150l12-9 10 5 18-17" stroke="#e6edf5" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M72 194h216" stroke="#8b96a2" stroke-opacity=".5" stroke-linecap="round"/>
    </svg>`,
  },
  {
    key: 2,
    type: 'Legacy modernization',
    title: 'A safer path forward',
    desc: 'Improving an existing application in measured steps, without an unnecessary rewrite.',
    delay: 'delay-1',
    art: `<svg viewBox="0 0 360 220" fill="none" aria-hidden="true">
      <rect x="52" y="35" width="105" height="150" rx="7" stroke="#8b96a2" stroke-opacity=".55"/>
      <rect x="203" y="35" width="105" height="150" rx="7" stroke="#dbe4ee" stroke-opacity=".7"/>
      <path d="M70 65h68M70 82h48M70 99h61M70 116h42M221 65h68M221 82h51M221 99h61M221 116h42" stroke="#8b96a2" stroke-linecap="round"/>
      <path d="M160 110h38m-10-10 10 10-10 10" stroke="#e6edf5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="105" cy="151" r="12" stroke="#7c8b9b"/>
      <circle cx="255" cy="151" r="12" stroke="#e6edf5"/>
      <path d="M105 145v12m-6-6h12M249 151h12" stroke="#b7c2ce" stroke-linecap="round"/>
    </svg>`,
  },
  {
    key: 3,
    type: 'Infrastructure',
    title: 'Infrastructure that fits',
    desc: 'Planning the right server, network and backup setup for a growing operation.',
    delay: 'delay-2',
    art: `<svg viewBox="0 0 360 220" fill="none" aria-hidden="true">
      <path d="M78 60h204M78 110h204M78 160h204" stroke="#7c8b9b" stroke-opacity=".5" stroke-dasharray="3 6"/>
      <rect x="106" y="39" width="148" height="42" rx="6" fill="#242c35" stroke="#b7c2ce" stroke-opacity=".65"/>
      <rect x="106" y="89" width="148" height="42" rx="6" fill="#1a2028" stroke="#8b96a2" stroke-opacity=".65"/>
      <rect x="106" y="139" width="148" height="42" rx="6" fill="#242c35" stroke="#b7c2ce" stroke-opacity=".65"/>
      <g fill="#e6edf5"><circle cx="123" cy="60" r="3"/><circle cx="123" cy="110" r="3"/><circle cx="123" cy="160" r="3"/></g>
      <g stroke="#8b96a2" stroke-linecap="round"><path d="M139 56h91M139 65h64M139 106h91M139 115h64M139 156h91M139 165h64"/></g>
      <circle cx="238" cy="60" r="3.4" fill="#cfe0ff"/>
    </svg>`,
  },
];
---

<section class="section work" id="work">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="sec-id">
        <span class="num">04</span><span data-i18n="work_index">Engineering in practice</span>
      </div>
      <h2 class="heading" data-i18n="work_title">Different problems. Thoughtful systems.</h2>
      <p class="lead" data-i18n="work_intro">
        A glimpse into the kinds of engineering challenges we can take on. These are illustrative
        scenarios, not claimed client engagements.
      </p>
    </div>

    <div class="work-grid">
      {work.map((item) => (
        <article class={`work-card glass reveal ${item.delay}`.trim()}>
          <div class="work-art"><Fragment set:html={item.art} /></div>
          <div class="work-body">
            <div class="work-labels">
              <span class="work-badge" data-i18n="work_badge">Fictional concept</span>
              <span class="work-type" data-i18n={`work${item.key}_type`}>{item.type}</span>
            </div>
            <h3 data-i18n={`work${item.key}_title`}>{item.title}</h3>
            <p data-i18n={`work${item.key}_desc`}>{item.desc}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="concept-note" data-i18n="concept_note">
      Illustrative scenarios only. No client results or project history are implied.
    </p>
  </div>
</section>